---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// TODO: replace with your real experience. Newest first.
const experience = [
  {
    role: "[Job Title]",
    company: "[Company Name]",
    dates: "[Start] — [End]",
    description: "[One or two sentences about scope and impact in this role.]",
    tags: ["[Tech]", "[Tech]"],
  },
  {
    role: "[Previous Job Title]",
    company: "[Previous Company]",
    dates: "[Start] — [End]",
    description: "[One or two sentences about scope and impact in this role.]",
    tags: ["[Tech]", "[Tech]"],
  },
];

// TODO: replace with your real projects.
const projects = [
  {
    title: "[Project One]",
    description: "[One-line description of what it does and why it exists.]",
    stack: ["TypeScript", "Astro"],
    link: "https://github.com/[you]/[project-one]",
    problem: "[What problem was this solving?]",
    approach: "[How did you approach building it?]",
    learnings: "[What would you do differently, or what did you learn?]",
  },
  {
    title: "[Project Two]",
    description: "[One-line description of what it does and why it exists.]",
    stack: ["Node.js", "PostgreSQL"],
    link: "https://github.com/[you]/[project-two]",
    problem: "[What problem was this solving?]",
    approach: "[How did you approach building it?]",
    learnings: "[What would you do differently, or what did you learn?]",
  },
  {
    title: "[Project Three]",
    description: "[One-line description of what it does and why it exists.]",
    stack: ["Python"],
    link: "https://github.com/[you]/[project-three]",
    problem: "[What problem was this solving?]",
    approach: "[How did you approach building it?]",
    learnings: "[What would you do differently, or what did you learn?]",
  },
];

// TODO: replace with your real education.
const education = [
  {
    school: "[University Name]",
    degree: "[Degree, Field of Study]",
    dates: "[Start] — [End]",
  },
];

// TODO: replace with your real skills.
const skillGroups = [
  { category: "Languages", skills: ["[Language]", "[Language]"] },
  { category: "Frameworks & Libraries", skills: ["[Framework]", "[Framework]"] },
  { category: "Infrastructure & Tools", skills: ["[Tool]", "[Tool]"] },
  { category: "Currently exploring", skills: ["[Something you're learning]"] },
];

// Set this to enable the live GitHub activity feed below.
const GITHUB_USERNAME = ""; // e.g. "octocat"
---
<BaseLayout title="Home" description="Developer portfolio and blog.">
  <section id="about" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">01</span><h2>About</h2></div>
    <p>
      {/* TODO: replace with your real bio */}
      [A few sentences of background — what you work on, how you got into
      development, and what you're looking for right now.]
    </p>
  </section>

  <section id="experience" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">02</span><h2>Experience</h2></div>
    {experience.map((job) => (
      <div class="experience-item">
        <p class="dates">{job.dates}</p>
        <h3>{job.role} · {job.company}</h3>
        <p>{job.description}</p>
        <div>{job.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      </div>
    ))}
  </section>

  <section id="projects" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">03</span><h2>Projects</h2></div>
    {projects.map((project) => (
      <div class="card">
        <h3><a href={project.link} target="_blank" rel="noopener noreferrer">{project.title}</a></h3>
        <p>{project.description}</p>
        <div>{project.stack.map((tech) => <span class="tag">{tech}</span>)}</div>
        <details class="case-study">
          <summary>Case study</summary>
          <div class="case-content">
            <h4>Problem</h4>
            <p>{project.problem}</p>
            <h4>Approach</h4>
            <p>{project.approach}</p>
            <h4>Learnings</h4>
            <p>{project.learnings}</p>
          </div>
        </details>
      </div>
    ))}
  </section>

  <section id="education" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">04</span><h2>Education</h2></div>
    {education.map((entry) => (
      <div class="experience-item">
        <p class="dates">{entry.dates}</p>
        <h3>{entry.school}</h3>
        <p>{entry.degree}</p>
      </div>
    ))}
  </section>

  <section id="skills" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">05</span><h2>Skills</h2></div>
    {skillGroups.map((group) => (
      <div class="skills-group">
        <h3>{group.category}</h3>
        <div>{group.skills.map((skill) => <span class="tag">{skill}</span>)}</div>
      </div>
    ))}
  </section>

  <section id="github" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">06</span><h2>GitHub Activity</h2></div>
    <ul class="activity-list" id="github-activity" data-username={GITHUB_USERNAME}>
      <li>Loading recent activity…</li>
    </ul>
  </section>

  <section id="blog" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">07</span><h2>Blog</h2></div>
    {recentPosts.length === 0 && <p class="meta">No posts yet.</p>}
    {recentPosts.map((post) => (
      <div class="card">
        <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
        <p class="meta">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
        <p>{post.data.description}</p>
      </div>
    ))}
    <p><a href="/blog">→ View all posts</a></p>
  </section>
</BaseLayout>

<script>
  const list = document.getElementById('github-activity');
  const username = list?.dataset.username;

  const EVENT_LABELS = {
    PushEvent: 'pushed to',
    PullRequestEvent: 'opened a pull request in',
    IssuesEvent: 'opened an issue in',
    CreateEvent: 'created',
    WatchEvent: 'starred',
    ForkEvent: 'forked',
  };

  async function loadActivity() {
    if (!username) {
      list.innerHTML = '<li>Add your GitHub username in src/pages/index.astro (GITHUB_USERNAME) to enable this section.</li>';
      return;
    }
    try {
      const res = await fetch(`https://api.github.com/users/${username}/events/public`);
      if (!res.ok) throw new Error(`GitHub API returned ${res.status}`);
      const events = await res.json();
      const recent = events.slice(0, 5);
      if (!recent.length) {
        list.innerHTML = '<li>No recent public activity.</li>';
        return;
      }
      list.innerHTML = recent
        .map((event) => {
          const label = EVENT_LABELS[event.type] || event.type;
          const repo = event.repo?.name || '';
          const url = repo ? `https://github.com/${repo}` : '#';
          return `<li><a href="${url}" target="_blank" rel="noopener noreferrer">${label} ${repo}</a></li>`;
        })
        .join('');
    } catch (err) {
      list.innerHTML = "<li>Couldn't load GitHub activity right now — check the username or try again later.</li>";
    }
  }

  loadActivity();
</script>
