---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projects } from '../data/projects.js';
import ProjectCard from '../components/ProjectCard.astro';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const featuredProjects = projects.filter((p) => p.featured);

const skillGroups = [
  { category: "Languages", skills: ["Python", "JavaScript", "TypeScript", "HTML5", "CSS3"] },
  { category: "Frameworks & Libraries", skills: ["Django", "Flask", "FastAPI", "React", "Astro", "Next.js", "GraphQL", "Node.js", "Express", "Tailwind CSS", "Jinja2", "Ejs", "Bootstrap"] },
  { category: "Infrastructure & Tools", skills: ["MongoDB", "PostgreSQL", "SQLite", "Redis", "Git", "GitHub", "Docker", "Postman", "Linux", "Render", "Cloudflare", "Redis", "Ngrok", "Nginx"] },
  { category: "Currently exploring", skills: ["AI Agentic Engineering"] },
];

// Set this to enable the live GitHub activity feed below.
const GITHUB_USERNAME = "Eugene-Olok"; // e.g. "octocat"
---
<BaseLayout title="Home" description="Developer portfolio and blog.">
  <section id="about" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">01</span><h2>About</h2></div>
    <p>
        Hi there! I'm Eugene, and I like building things. I'm a full-stack engineer with expertise in crafting resilient backends and polished user experiences from Uganda that solve real-world problems. I take pride in writing clean, scalable code and have a sharp eye for the little details that separate a good product from an exceptional one. I enjoy working at the intersection of robust system architecture and thoughtful design.
    </p>

    <p>
        Currently, I work as an independent full-stack engineer and freelancer, helping clients bring digital products to life from scratch. Whether I'm architecting scalable APIs, building out high-performance databases, or polishing front-end interfaces, I partner closely with clients to ensure their vision translates into fast, reliable, and accessible software.
    </p>

    <p>
        I’ve worked across a wide range of environments, building and shipping web and mobile applications that scale. These experiences have shaped how I think about engineering products that are both technically sound and impactful for users.
    </p>
  </section>

  <section id="projects" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">02</span><h2>Projects</h2></div>
    {featuredProjects.map((project) => <ProjectCard project={project} />)}
    <p><a href="/projects">→ View all projects</a></p>
  </section>

  <section id="skills" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">03</span><h2>Skills</h2></div>
    {skillGroups.map((group) => (
      <div class="skills-group">
        <h3>{group.category}</h3>
        <div>{group.skills.map((skill) => <span class="tag">{skill}</span>)}</div>
      </div>
    ))}
  </section>

  <section id="github" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">04</span><h2>GitHub Activity</h2></div>
    <ul class="activity-feed" id="github-activity" data-username={GITHUB_USERNAME}>
      <li class="activity-item"><div class="activity-text">Loading recent activity…</div></li>
    </ul>
  </section>

  <section id="blog" class="section" data-reveal>
    <div class="section-heading"><span class="section-index">05</span><h2>Blog</h2></div>
    {recentPosts.length === 0 && <p class="meta">No posts yet.</p>}
    {recentPosts.map((post) => (
      <div class="card">
        <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
        <p class="meta">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
        <p>{post.data.description}</p>
      </div>
    ))}
    <p><a href="/blog">→ View all posts</a></p>
  </section>
</BaseLayout>

<script>
  const list = document.getElementById('github-activity');
  const username = list?.dataset.username;

  const ICONS = {
    PushEvent: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>',
    PullRequestEvent: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="6" r="2"/><path d="M6 8v8M18 8v4a4 4 0 01-4 4h-2"/></svg>',
    IssuesEvent: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>',
    CreateEvent: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>',
    WatchEvent: '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7-6.2-3.9L6 21.2l1.6-7L2.2 9.5l7.1-.6z"/></svg>',
    ForkEvent: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M6 8v2a4 4 0 004 4M18 8v2a4 4 0 01-4 4"/></svg>',
  };

  const LABELS = {
    PushEvent: 'pushed to',
    PullRequestEvent: 'opened a pull request in',
    IssuesEvent: 'opened an issue in',
    CreateEvent: 'created',
    WatchEvent: 'starred',
    ForkEvent: 'forked',
  };

  function timeAgo(dateStr) {
    const time = new Date(dateStr).getTime();
    if (Number.isNaN(time)) return '';
    const diffMs = Date.now() - time;
    const mins = Math.floor(diffMs / 60000);
    if (mins < 60) return `${mins}m ago`;
    const hours = Math.floor(mins / 60);
    if (hours < 24) return `${hours}h ago`;
    const days = Math.floor(hours / 24);
    if (days < 30) return `${days}d ago`;
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  async function loadActivity() {
    if (!username) {
      list.innerHTML = '<li class="activity-item"><div class="activity-text">Add your GitHub username in src/pages/index.astro (GITHUB_USERNAME) to enable this section.</div></li>';
      return;
    }
    try {
      const res = await fetch(`https://api.github.com/users/${username}/events/public`);
      if (!res.ok) throw new Error(`GitHub API returned ${res.status}`);
      const events = await res.json();
      const recent = events.slice(0, 5);
      if (!recent.length) {
        list.innerHTML = '<li class="activity-item"><div class="activity-text">No recent public activity.</div></li>';
        return;
      }
      list.innerHTML = recent
        .map((event) => {
          const icon = ICONS[event.type] || ICONS.CreateEvent;
          const label = LABELS[event.type] || event.type;
          const repo = event.repo?.name || '';
          const url = repo ? `https://github.com/${repo}` : '#';
          return `<li class="activity-item">
            <div class="activity-icon">${icon}</div>
            <div class="activity-text">
              <a href="${url}" target="_blank" rel="noopener noreferrer">${label} ${repo}</a>
              <span class="activity-time">${timeAgo(event.created_at)}</span>
            </div>
          </li>`;
        })
        .join('');
    } catch (err) {
      list.innerHTML = "<li class=\"activity-item\"><div class=\"activity-text\">Couldn't load GitHub activity right now — check the username or try again later.</div></li>";
    }
  }

  loadActivity();
</script>
