---
import BaseLayout from '../layouts/BaseLayout.astro';

// TODO: replace with your real projects. Hardcoded per current scope (no CMS).
const projects = [
  {
    title: "[Project One]",
    description: "[One-line description of what it does and why it exists.]",
    stack: ["TypeScript", "Astro"],
    link: "https://github.com/[you]/[project-one]",
  },
  {
    title: "[Project Two]",
    description: "[One-line description of what it does and why it exists.]",
    stack: ["Node.js", "PostgreSQL"],
    link: "https://github.com/[you]/[project-two]",
  },
  {
    title: "[Project Three]",
    description: "[One-line description of what it does and why it exists.]",
    stack: ["Python"],
    link: "https://github.com/[you]/[project-three]",
  },
];
---
<BaseLayout title="Projects" description="A selection of projects I've built.">
  <h1>Projects</h1>
  {projects.map((project) => (
    <div class="card">
      <h2><a href={project.link} target="_blank" rel="noopener noreferrer">{project.title}</a></h2>
      <p>{project.description}</p>
      <div>
        {project.stack.map((tech) => <span class="tag">{tech}</span>)}
      </div>
    </div>
  ))}
</BaseLayout>
