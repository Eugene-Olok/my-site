---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects.js';

const allTags = [...new Set(projects.flatMap((p) => p.stack))].sort();
---
<BaseLayout title="Projects" description="All projects.">
  <h1>All Projects</h1>
  {allTags.length > 0 && (
    <div class="tag-filter" id="tag-filter">
      <button class="tag-filter-btn is-active" data-tag-filter="all">All</button>
      {allTags.map((tag) => (
        <button class="tag-filter-btn" data-tag-filter={tag}>{tag}</button>
      ))}
    </div>
  )}
  <div class="row-list">
    {projects.map((project) => (
      <div class="row-item filterable-card" data-tags={project.stack.join(',')}>
        <div class="row-item-main">
          <h2 class="row-item-title">{project.title}</h2>
          <p class="row-item-desc">{project.description}</p>
          <div class="row-item-tags">
            {project.stack.map((tech) => <span class="tag">{tech}</span>)}
          </div>
        </div>
        <div class="row-item-links">
          <a href={`/projects/${project.slug}`} aria-label={`${project.title} case study`} title="Case study">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h6"/></svg>
          </a>
          <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} live site`} title="Live site">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><path d="M15 3h6v6"/><path d="M10 14L21 3"/></svg>
          </a>
          <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={`${project.title} GitHub repository`} title="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </a>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  import { initTagFilter } from '../scripts/tag-filter.js';
  const filterBar = document.getElementById('tag-filter');
  if (filterBar) initTagFilter(filterBar);
</script>
