---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/reading-time.js';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<BaseLayout title="Blog" description="Posts on things I'm building and learning.">
  <h1>Blog</h1>
  {posts.length === 0 && <p class="meta">No posts yet.</p>}
  {posts.length > 0 && allTags.length > 0 && (
    <div class="tag-filter" id="tag-filter">
      <button class="tag-filter-btn is-active" data-tag-filter="all">All</button>
      {allTags.map((tag) => (
        <button class="tag-filter-btn" data-tag-filter={tag}>{tag}</button>
      ))}
    </div>
  )}
  <div class="row-list">
    {posts.map((post) => {
      const { minutes } = getReadingTime(post.body ?? '');
      return (
        <a href={`/blog/${post.id}/`} class="row-item filterable-card" data-tags={post.data.tags.join(',')}>
          <div class="row-item-main">
            <h2 class="row-item-title">{post.data.title}</h2>
            <p class="meta">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              {' · '}{minutes} min read
            </p>
            <p class="row-item-desc">{post.data.description}</p>
            <div class="row-item-tags">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
          <div class="row-item-links">
            <span class="row-item-arrow" aria-hidden="true">→</span>
          </div>
        </a>
      );
    })}
  </div>
</BaseLayout>

<script>
  import { initTagFilter } from '../../scripts/tag-filter.js';
  const filterBar = document.getElementById('tag-filter');
  if (filterBar) initTagFilter(filterBar);
</script>
