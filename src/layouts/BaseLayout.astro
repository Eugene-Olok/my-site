---
import '../styles/global.css';

const { title, description = "Developer portfolio and blog." } = Astro.props;
const pageTitle = title ? `${title} · [YOUR NAME]` : "[YOUR NAME]";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">~/[your-handle]</a>
      <nav>
        <a href="/">home</a>
        <a href="/projects">projects</a>
        <a href="/blog">blog</a>
        <a href="/about">about</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>&copy; {new Date().getFullYear()} [YOUR NAME]. Built with Astro.</p>
    </footer>
  </body>
</html>
