<canvas id="particle-field" aria-hidden="true"></canvas>
<div class="cursor-spotlight" aria-hidden="true"></div>
<div class="cursor-dot" aria-hidden="true"></div>

<style>
  #particle-field {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1; /* Puts stars in the background */
    pointer-events: none;
  }

  .cursor-spotlight {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 2; /* Sits just above stars, below layout */
    pointer-events: none;
    background: radial-gradient(circle 600px at var(--spot-x, 50vw) var(--spot-y, 50vh), rgba(var(--accent-rgb), 0.08), rgba(var(--accent-rgb), 0) 45%);
  }

  .cursor-dot {
    position: fixed;
    top: 0;
    left: 0;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    pointer-events: none;
    z-index: 9999; /* Dot stays on top of everything */
    transform: translate(-100px, -100px);
    transition: transform 0.08s ease-out, opacity 0.2s ease;
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    #particle-field,
    .cursor-spotlight,
    .cursor-dot {
      display: none;
    }
  }

  @media not all and (hover: hover) and (pointer: fine) {
    .cursor-spotlight,
    .cursor-dot {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canPreciseHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  function getThemeColors() {
    const styles = getComputedStyle(document.documentElement);
    return {
      dot: styles.getPropertyValue('--text-rgb').trim() || '230, 237, 243',
      link: styles.getPropertyValue('--accent-rgb').trim() || '126, 231, 135',
    };
  }

  let colors = getThemeColors();
  window.addEventListener('themechange', () => {
    colors = getThemeColors();
  });

  if (!reduceMotion) {
    const canvas = document.getElementById('particle-field');
    const ctx = canvas.getContext('2d');

    const PARTICLE_COUNT = 150;
    const LINK_DISTANCE = 100;
    const CURSOR_LINK_DISTANCE = 200;

    let width = window.innerWidth;
    let height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;

    let particles = Array.from({ length: PARTICLE_COUNT }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.3,
      vy: (Math.random() - 0.5) * 0.3,
    }));

    const mouse = { x: -9999, y: -9999 };

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      document.documentElement.style.setProperty('--spot-x', `${e.clientX}px`);
      document.documentElement.style.setProperty('--spot-y', `${e.clientY}px`);
    });

    // FIX: Scale particles proportionally on resize instead of clamping them
    window.addEventListener('resize', () => {
      const newWidth = window.innerWidth;
      const newHeight = window.innerHeight;

      particles.forEach((p) => {
        p.x = (p.x / width) * newWidth;
        p.y = (p.y / height) * newHeight;
      });

      width = newWidth;
      height = newHeight;
      canvas.width = width;
      canvas.height = height;
    });

    function step() {
      for (const p of particles) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x <= 0 || p.x >= width) p.vx *= -1;
        if (p.y <= 0 || p.y >= height) p.vy *= -1;
      }
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);

      for (let i = 0; i < particles.length; i++) {
        const distToCursorI = Math.hypot(particles[i].x - mouse.x, particles[i].y - mouse.y);
        
        for (let j = i + 1; j < particles.length; j++) {
          const distToCursorJ = Math.hypot(particles[j].x - mouse.x, particles[j].y - mouse.y);
          
          if (distToCursorI < CURSOR_LINK_DISTANCE && distToCursorJ < CURSOR_LINK_DISTANCE) {
             const distParticles = Math.hypot(particles[i].x - particles[j].x, particles[i].y - particles[j].y);
             
             if (distParticles < LINK_DISTANCE) {
                const opacity = (1 - distParticles / LINK_DISTANCE) * (1 - Math.max(distToCursorI, distToCursorJ) / CURSOR_LINK_DISTANCE);
                ctx.strokeStyle = `rgba(${colors.link}, ${opacity})`;
                ctx.lineWidth = 1;
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.stroke();
             }
          }
        }

        ctx.fillStyle = `rgba(${colors.dot}, 0.6)`;
        ctx.beginPath();
        ctx.arc(particles[i].x, particles[i].y, 1.2, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    let rafId = null;

    function loop() {
      step();
      draw();
      rafId = requestAnimationFrame(loop);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = null;
      } else if (!rafId) {
        loop();
      }
    });

    loop();
  }

  if (canPreciseHover) {
    const dot = document.querySelector('.cursor-dot');
    window.addEventListener('mousemove', (e) => {
      dot.style.opacity = '1';
      dot.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    });
    window.addEventListener('mouseleave', () => {
      dot.style.opacity = '0';
    });
  }
</script>